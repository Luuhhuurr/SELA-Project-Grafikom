  m_Script: {fileID: 11500000, guid: cf10ac204eb74897b6ff07a831088979, type: 3}
  m_Name: NaskahHari2
  m_EditorClassIdentifier: SELA.Runtime::NaskahData
  hari: 2
  judul: "Dita Mengecek Lowongan Studio Lajur"
  ringkasan: "Pagi kedua. Dita mengirim ulang lowongan Studio Lajur beserta batas lamarannya."
  pengirim: "Dita"
  pesanPembuka: "Raka, lowongan Studio Lajur yang kemarin itu masih dibuka. Tapi mereka cuma menerima lamaran sampai malam hari ketiga. Kalau mau melamar, jangan tunggu sampai akhir."
  pesanLain:
  - "Dita (07:10) — Yang mereka cari orang yang pernah ngerjain antarmuka formulir. Portofolio kamu bagian itu kepake, bukan?"
  - "Studio Lajur (09:30) — Lamaran untuk posisi Junior UI Implementer kami terima sampai hari ketiga malam. Mohon sertakan portofolio antarmuka."
  perusahaanLowongan: "Studio Lajur"
  judulLowongan: "Junior UI Implementer"
  draftLowongan: "Tugas: membuat antarmuka formulir internal, hasilnya direview senior. Gaji Rp4.200.000 per bulan, 40 jam per minggu, 2 hari istirahat. Dokumen asli dipegang pekerja, salinan tetap milik pelamar. Jaminan sosial tertulis. Ada pendamping tim."
  batasLamaran: "Hari 3 malam"
  syaratLamaran: "Portofolio antarmuka (E1)"
  catatanTambahan: "Hari ke-2. Meja di kamar terasa lebih jauh dari biasanya. Kartu proyek ada di rak."
