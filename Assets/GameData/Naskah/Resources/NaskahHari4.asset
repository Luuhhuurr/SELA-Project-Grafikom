  m_Script: {fileID: 11500000, guid: cf10ac204eb74897b6ff07a831088979, type: 3}
  m_Name: NaskahHari4
  m_EditorClassIdentifier: SELA.Runtime::NaskahData
  hari: 4
  judul: "Akses Prima Menghubungi Raka"
  ringkasan: "Hari keempat. Akses Prima menawarkan gaji besar tanpa interview. Lorong kos hari ini lebih panjang dari biasa."
  pengirim: "Akses Prima"
  pesanPembuka: "Selamat pagi. Kami dari Akses Prima membutuhkan Junior Developer untuk aplikasi formulir klien. Proses cepat, bisa mulai minggu ini. Kompensasi sampai Rp12.000.000. Mohon bawa KTP dan ijazah asli saat tanda tangan. Hubungi 0812-xxxx lewat WhatsApp saja, kantor tutup hari Sabtu."
  pesanLain:
  - "Dita (08:15) — Akses Prima? Kirim KTP dan ijazah asli, jangan ya. Aku coba cari alamatnya, beneran nggak ada di peta."
  - "Dita (08:16) — Kalau mau ke studio, bawa portofolio di flashdisk. HP kadang gak kebaca di laptop mereka."
  perusahaanLowongan: "Akses Prima"
  judulLowongan: "Junior Developer"
  draftLowongan: "Kerjakan aplikasi formulir untuk klien. Bayar sampai Rp12.000.000, proses cepat, bisa mulai minggu ini. Dokumen asli KTP dan ijazah dibawa saat tanda tangan. Pengunduran diri minimal satu tahun. Tidak ada interview."
  batasLamaran: "Hari 7 malam"
  syaratLamaran: "Dokumen asli KTP dan ijazah"
  catatanTambahan: "Hari ke-4. Lorong kos hari ini lebih panjang dari biasa. Kunci kamar 07 ada di bangku dekat pintu."
